# Lint the JS/TS files changed in the commit range that is being pushed.

zero='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion carries no content to lint.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: compare against the default branch when it exists.
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  if [ -n "$base" ]; then
    files=$(git diff -z --name-only --diff-filter=ACMR "$base" "$local_sha" -- \
      '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx')
  else
    files=$(git ls-files -z -- \
      '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx')
  fi

  if [ -z "$files" ]; then
    continue
  fi

  printf '%s' "$files" | xargs -0 pnpm exec oxlint || exit 1
done
