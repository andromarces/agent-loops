# Push gate: repo-wide formatting check, then lint the JS/TS files changed
# in the commit range that is being pushed.

# Check formatting repo-wide. oxfmt covers Markdown, which lint-staged
# (JS/TS-only on pre-commit) never sees, so CI is otherwise the first place
# a formatting failure surfaces. This runs the same check CI runs; it is a
# check, not a formatter, so it processes no files.
pnpm exec oxfmt --check || exit 1

zero='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion carries no content to lint.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: compare against the default branch when it exists.
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  # NUL streams never touch a variable (command substitution cannot hold
  # null bytes). The newline listing only tests for emptiness, so the NUL
  # stream below is guaranteed non-empty and plain xargs -0 suffices.
  # (xargs -0 -r would work too: BSD xargs accepts -r as a GNU-compat
  # no-op and natively skips empty input.)
  if [ -n "$base" ]; then
    if [ -n "$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- \
      '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx')" ]; then
      git diff -z --name-only --diff-filter=ACMR "$base" "$local_sha" -- \
        '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx' \
        | xargs -0 pnpm exec oxlint || exit 1
    fi
  else
    if [ -n "$(git ls-files -- \
      '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx')" ]; then
      git ls-files -z -- \
        '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx' \
        | xargs -0 pnpm exec oxlint || exit 1
    fi
  fi
done
