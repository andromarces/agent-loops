{
  "agent-loop-parent-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|sed_file|notebook_edit|invoke_subagent|send_message",
        "hooks": [
          {
            "type": "command",
            "command": "node ./agent-loop-antigravity-parent-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
