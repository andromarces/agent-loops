{
  "description": "Parent-edit guard for agent-loop Codex sessions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/src/hook/parent-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking parent orchestration guard"
          }
        ]
      }
    ]
  }
}
