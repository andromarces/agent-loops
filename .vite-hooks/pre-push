# Push gate: repo-wide formatting check, then lint the JS/TS files changed
# in the commit range that is being pushed.

# Check formatting repo-wide. vp fmt covers Markdown, which vp staged
# (JS/TS-only on pre-commit) never sees, so CI is otherwise the first place
# a formatting failure surfaces. This runs the same check CI runs; it is a
# check, not a formatter, so it processes no files.
pnpm exec vp fmt --check || exit 1

zero='0000000000000000000000000000000000000000'

# The JS/TS globs, set once as the positional parameters.
set -- '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts' '*.jsx' '*.tsx'

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion carries no content to lint.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: compare against the default branch when it exists.
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  # A NUL stream cannot sit in a variable, so xargs -0 reads it from the pipe.
  # GNU xargs runs the command once on empty input and BSD xargs does not, so
  # the inner shell skips the lint when it gets no file. xargs -r is not used,
  # because a minimum macOS version that supports it is not established.
  # The inner "$@" is the file list of xargs, not the globs above.
  {
    if [ -n "$base" ]; then
      git diff -z --name-only --diff-filter=ACMR "$base" "$local_sha" -- "$@"
    else
      git ls-files -z -- "$@"
    fi
  } | xargs -0 sh -c '[ "$#" -eq 0 ] || exec pnpm exec vp lint "$@"' sh || exit 1
done
